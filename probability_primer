colnames(Table_2) <- c("A", "f_a")
Table_2[1:3] <- c(5000,5000+1000*1,5000+1000*2)
Table_2[1,2] <- fb_1
Table_2[2,2] <- fb_2
Table_2[3,2] <- fb_3
print(Table_2)

# Therefore the distribution is:
#   A    f_a
# 5000  0.15
# 6000  0.50
# 7000  0.35

