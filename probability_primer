#P.7
# ‘‘Charley Chicken’’ and ‘‘Bradley Bee’’ are brands of canned tuna. During a week a certain amount of advertising appears for these products. 
# There may be no advertising, one form of advertising (newspaper coupon), or two forms (coupon and a special store display). Let C denote the 
# level of advertising for Charley Chicken. It can take the values c 1⁄4 0, 1 or 2. Let B denote the level of advertising of Bradley Bee; B can 
# take the values b 1⁄4 0, 1 or 2. 

# Suppose the following table represents the joint probability distribution of the advertising levels for these two brands of canned tuna.

table <- matrix (c(0.05,0.05,0.05, 0.05, 0.20, 0.15, 0.05, 0.25, 0.15), ncol=3, byrow=TRUE)
colnames(table) <- c('0', '1', '2')
rownames(table) <- c('0', '1', '2')
table <- as.table(table)
table

#      B1   B2   B3
# C1 0.05 0.05 0.05
# C2 0.05 0.20 0.15
# C3 0.05 0.25 0.15

# (a) What is the marginal probability distribution of Charley Chicken advertising,C?
#f(c) and f(b) for each row and column

fc_1 <- sum(0.05, 0.05, 0.05)
fc_1 #0.15

fc_2 <- sum(0.05, 0.20, 0.15)
fc_2 #0.4

fc_3 <- sum(0.05, 0.25, 0.15)
fc_3 #0.45

f_c <- c(0.15,0.4,0.45)
cbind(table,f_c)

#     0    1    2  f_c
# 0 0.05 0.05 0.05 0.15
# 1 0.05 0.20 0.15 0.40
# 2 0.05 0.25 0.15 0.45

fb_1 <- sum(0.05, 0.05, 0.05)
fb_2 <- sum(0.05, 0.20, 0.25)
fb_3 <- sum(0.05, 0.15, 0.15)

f_b <- c(fb_1, fb_2, fb_3)
rbind(table,f_b)

#       0    1    2
# 0   0.05 0.05 0.05
# 1   0.05 0.20 0.15
# 2   0.05 0.25 0.15
# f_b 0.15 0.50 0.35

# (b) What is the expected value of C?

#     0    1    2  f_c
# 0 0.05 0.05 0.05 0.15
# 1 0.05 0.20 0.15 0.40
# 2 0.05 0.25 0.15 0.45

Expected_Value_C <- (0*0.15)+(1*0.40)+(2*0.45)
Expected_Value_C
# [1] 1.3

# (c) What is the variance of C? 

# Var(X) = E(X^2) - [E(X)]^2

Variance_C <- (0^2*0.15)+(1^2*0.40)+(2^2*0.45) - Expected_Value_C^2
Variance_C
# [1] 0.51

# (d) Are the two companies’ advertising strategies statistically independent? Explain.
# the two companies’ advertising strategies are not independent.
# If independent, condition must hold as f(C,B) = f(C)*f(B)

# (e) Bradley Bee pays its advertising firm $5,000 per week plus $1,000 for each level of 
# advertising B. What is the probability distribution of Bradley Bee’s advertising outlay, A?

# A = 5000 + 1000*B

