# Use Least Squares Estimators to solve for beta_1 and beta_2
# beta_2 = sum(x-x_bar)(y-y_bar)/sum(x-x_bar)^2

beta_2_numerator <- sum((0-x_bar)*(6-y_bar),(1-x_bar)*(2-y_bar),(2-x_bar)*(3-y_bar), (3-x_bar)*(1-y_bar),(4-x_bar)*(0-y_bar))
