#Question 2: Use the variable ageq2nd and the variable ageq3rd to construct an 
#indicator variable on whether there was a multiple pregnancy during the mother's 
#second pregnancy. What is the proportion of households with a multiple pregnancy in the second pregnancy?

#Loading Required Library
library("AER")

#Constructing an Indicator Variable Using ageq2nd and age3rd variables
census80$three <- (census80$numberkids==3)
census80$temp[census80$ageq2nd == census80$ageq3rd] <- 1 #Creating a temporary vector that meets the given criteria
census80$multiple <- 0 
census80$multiple[census80$temp == 1] <- 1
summary(census80$multiple)

