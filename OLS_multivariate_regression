############################################################################
Multivariate Regression

Formula ---> y = beta_o + beta_1 + beta_2 + beta_3 + epsilon (or U for standard error)

multi <- lm(Y~X_1 + X_2 + X_3)


######################## EXAMPLE ############################################

multi <- lm(nlsw88$lwage ~ nlsw88$yrs_school + nlsw88$ttl_exp)
summary(multi) 

